# Public mobile app configuration. Values loaded into React Native are bundled
# into the app and must not be treated as secrets.
FRAPPE_BASE_URL=https://buyinminutes.u.frappe.cloud
GOOGLE_MAPS_API_KEY=replace-with-restricted-public-key
STRIPE_PUBLISHABLE_KEY=replace-with-publishable-key
FIREBASE_GOOGLE_IOS_CLIENT_ID=replace-with-ios-client-id
FIREBASE_GOOGLE_WEB_CLIENT_ID=replace-with-web-client-id

# Server-only secrets. Do not load these into the React Native app bundle.
# Keep these only in a trusted backend/Frappe server environment.
FRAPPE_API_KEY=replace-on-server-only
FRAPPE_API_SECRET=replace-on-server-only
